{
  "name": "auditoria-qa-campus",
  "version": "1.0.0",
  "private": true,
  "description": "Pruebas automatizadas de la auditoría de calidad de El Campus También Se Daña (UNIMINUTO, Testing y QA)",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=e2e",
    "test:headed": "playwright test --project=e2e --headed",
    "test:demo": "playwright test -g \"CP-18|CP-07|CP-09\" --project=api",
    "report": "playwright show-report resultados/local/html",
    "cobertura": "node cobertura/ejecutar-con-cobertura.mjs",
    "tres-ejecuciones": "node cobertura/ejecutar-con-cobertura.mjs 3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "c8": "^10.1.3",
    "tsx": "^4.20.0"
  }
}
